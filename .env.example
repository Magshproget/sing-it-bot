# Discord Bot Credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Search provider: "genius" or "sqlite" or "both"
LYRIC_SEARCH_PROVIDER=genius

# Genius API (Optional but recommended to avoid 429 rate limit)
# Generate a free Client Access Token at: https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=

# Local SQLite Lyric Database path (if using sqlite or both)
SQLITE_DB_PATH=data/lyrics.db

# Whisper model path (default: models/ggml-large-v3-turbo-q5_0.bin)
WHISPER_MODEL_PATH=models/ggml-large-v3-turbo-q5_0.bin
WHISPER_PORT=8080
